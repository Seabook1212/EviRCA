  "fault_types": ["pod_cpu_hog", "pod_network_latency", "pod_network_loss/corruption", "pod_delete", "pod_memory_hog", "node_cpu_hog", "pod_container_kill", "springboot_app_kill", "springboot_cpu_stress", "springboot_exception", "springboot_memory_stress", "springboot_network_latency"],
